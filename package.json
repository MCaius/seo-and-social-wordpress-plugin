{
  "name": "seo-and-social-wordpress-plugin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:zip": "node scripts/build-zip.mjs",
    "env:start": "wp-env --config=.wp-env.json start",
    "env:stop": "wp-env --config=.wp-env.json stop",
    "env:destroy": "wp-env --config=.wp-env.json destroy",
    "env:phpunit:start": "wp-env --config=.wp-env.phpunit.json start",
    "env:phpunit:stop": "wp-env --config=.wp-env.phpunit.json stop",
    "test:php": "wp-env --config=.wp-env.phpunit.json run cli php wp-content/plugins/seo-and-social/vendor/bin/phpunit -c wp-content/plugins/seo-and-social/phpunit.xml.dist --do-not-cache-result",
    "env:e2e:start": "wp-env --config=.wp-env.e2e.json start",
    "env:e2e:stop": "wp-env --config=.wp-env.e2e.json stop",
    "env:package:start": "wp-env --config=.wp-env.package.json start",
    "env:package:stop": "wp-env --config=.wp-env.package.json stop",
    "syntax:php": "find seo-and-social -name '*.php' -print0 | xargs -0 -n1 php -l",
    "lint:php": "composer lint:php",
    "validate": "npm run syntax:php && npm run test:php && npm run build:zip"
  },
  "devDependencies": {
    "@wordpress/env": "^11.13.0"
  },
  "overrides": {
    "adm-zip": "0.6.0"
  }
}
